{
  "name": "gladys-triggercmd",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for TRIGGERcmd: run the commands of your computers (Windows, Mac, Linux, Raspberry Pi) from Gladys devices, scenes and a dashboard widget, and start Gladys scenes from Alexa, Google Assistant or TRIGGERcmd through an optional \"Gladys\" computer.",
  "homepage": "https://github.com/William-De71/gladys-triggercmd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-triggercmd.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "triggercmd",
    "remote-command",
    "computer",
    "alexa",
    "google-assistant",
    "home-automation"
  ]
}
